{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-sysprompt-override"],
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow"
  },
  "agent": {
    "build": {
      "permission": {
        "local-memory": "deny",
        "memory": "deny"
      }
    },
    "inkling": {
      "model": "openrouter/thinkingmachines/inkling:free",
      "mode": "primary",
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "question": "allow",
        "local-memory": "allow",
        "memory": "allow"
      }
    },
    "orchestrator": {
      "permission": {
        "local-memory": "deny",
        "memory": "deny"
      }
    },
    "plan": {
      "permission": {
        "local-memory": "deny",
        "memory": "deny"
      }
    }
  }
}
